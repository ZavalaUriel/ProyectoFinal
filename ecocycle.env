# ============================================
# EcoCycle - Configuración Centralizada
# ============================================
# Este archivo es la ÚNICA fuente de verdad.
# Todos los componentes lo consumen directa o indirectamente.
# Después de cambiarlo, regenera configs:
#   python3 scripts/generate_configs.py

# --- Máquina ---
MACHINE_ID=machine_001

# --- Visor (NestJS) ---
VISOR_PORT=3000

# --- YOLO ---
YOLO_PORT=8000
YOLO_CONF_THRESHOLD=0.15
YOLO_MODEL_PATH=yolov8s.pt

# --- Firebase ---
FIREBASE_DATABASE_URL=https://ecocycle-e9c04-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=ecocycle-e9c04
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-key.json

# --- .NET Backend ---
NET_API_PORT=5000

# --- WiFi (para ESP32-CAM) ---
WIFI_SSID="Redmi 13"
WIFI_PASSWORD="urielzavaal"

# --- ESP32-CAM Pines ---
IR_SENSOR_PIN=13
OUTER_GATE_PIN=12
INNER_GATE_PIN=14

# --- Red (para comunicación entre dispositivos) ---
# IP del servidor donde corre Visor + .NET backend
# Los Android y ESP32 necesitan esta IP para conectarse
SERVER_HOST=104.248.187.43
SERVER_DOMAIN=ecocyclemx.tech

# ============================================
# EcoCycle - Configuración Centralizada (PLANTILLA)
# ============================================
# Copiar a ecocycle.env y rellenar los valores reales:
#   cp ecocycle.env.example ecocycle.env
# Después de cambiarlo, regenera configs de dispositivos:
#   python3 scripts/generate_configs.py

# --- Máquina ---
MACHINE_ID=machine_001

# --- Seguridad dispositivos IoT ---
# API key compartida entre servidor, tablet de la máquina y ESP32.
# Generar con: openssl rand -hex 24
# Si se deja vacía, los endpoints de máquina quedan abiertos (solo desarrollo).
MACHINE_API_KEY=

# --- Visor (NestJS) ---
VISOR_PORT=3000

# Guardar imágenes de depuración en disco (true solo para diagnosticar)
DEBUG_IMAGES=false

# --- Gemini (detector principal; si falta la key se usa YOLO) ---
# Obtener key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# --- YOLO (respaldo si Gemini falla o no hay key) ---
YOLO_PORT=8000
YOLO_CONF_THRESHOLD=0.35
YOLO_MODEL_PATH=yolov8n.pt

# --- Firebase ---
FIREBASE_DATABASE_URL=https://<proyecto>-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=<proyecto>
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-key.json

# --- .NET Backend ---
NET_API_PORT=5000

# Contraseña de aplicación SMTP (Gmail → Contraseñas de aplicación)
SMTP_PASSWORD=

# --- WiFi (para ESP32-CAM) ---
WIFI_SSID=""
WIFI_PASSWORD=""

# --- ESP32-CAM Pines ---
IR_SENSOR_PIN=13
OUTER_GATE_PIN=12
INNER_GATE_PIN=14

# --- Red (para comunicación entre dispositivos) ---
# IP o dominio del servidor donde corre Visor + .NET backend
SERVER_HOST=
SERVER_DOMAIN=
